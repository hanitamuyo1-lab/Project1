PORT=4000

# Comma-separated list of origins allowed to call this API (your static site's URL)
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# https://dashboard.stripe.com/apikeys — use the SECRET key (starts with sk_), never the publishable one here
STRIPE_SECRET_KEY=
# Price in pence for the one-time unlock (399 = £3.99)
UNLOCK_PRICE_PENCE=399
# Where Stripe should send the browser back to after checkout (your live site)
APP_URL=http://localhost:5500
